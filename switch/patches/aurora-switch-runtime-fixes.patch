+// Melee re-inits texobjs every frame, so a monotonic id made aurora's per-frame
+// object cache miss 100% of the time -- forcing a full XXH3 content hash of every
+// bound texture every frame and unbounded object-cache growth (the multi-ms
+// per-frame sweep seen in TEXSTATS). Deriving the id from the descriptor
+// (pointer + dims + format) instead makes identical re-inits collapse to one
+// stable key so the object cache hits. The resolver (lib/gx/texture.cpp)
+// re-verifies pointer+dims+format on every hit (so a hash collision is caught)
+// and periodically re-hashes the bytes (so an in-place content change under a
+// reused pointer self-heals). Never returns 0 (0 means "no cache").
+u32 mix_obj_id(u64 h) {
+  h ^= h >> 33;
+  h *= 0xff51afd7ed558ccdull;
+  h ^= h >> 33;
+  h *= 0xc4ceb9fe1a85ec53ull;
+  h ^= h >> 33;
+  const auto id = static_cast<u32>(h) ^ static_cast<u32>(h >> 32);
+  return id == 0 ? 1u : id;
+}
+
+u32 stable_tex_obj_id(const void* data, u16 width, u16 height, u32 format, bool mipmap) {
+  u64 h = reinterpret_cast<u64>(data);
+  h = h * 0x100000001b3ull + (static_cast<u64>(width) | (static_cast<u64>(height) << 16));
+  h = h * 0x100000001b3ull + (static_cast<u64>(format) | (static_cast<u64>(mipmap) << 32));
+  return mix_obj_id(h);
+}
+
+u32 stable_tlut_obj_id(const void* data, u32 format, u16 entries) {
+  u64 h = reinterpret_cast<u64>(data);
+  h = h * 0x100000001b3ull + (static_cast<u64>(format) | (static_cast<u64>(entries) << 32));
+  return mix_obj_id(h);
 }
 
