+void aurora_flush_caches() {
+#ifdef AURORA_ENABLE_GX
+  // Switch tears the process down with svcExitProcess and no fini processing,
+  // so nothing else on the way out will commit what the shader blob cache has
+  // buffered. Called from the exit wrapper -- see switch/src/clang_tls_switch.c.
+  aurora::webgpu::cache_flush();
+#endif
