diff --git a/src/dawn/native/vulkan/BackendVk.cpp b/src/dawn/native/vulkan/BackendVk.cpp
index a93ea4f99..045146950 100644
--- a/src/dawn/native/vulkan/BackendVk.cpp
+++ b/src/dawn/native/vulkan/BackendVk.cpp
@@ -69,6 +69,11 @@ constexpr char kVulkanLibName[] = "vulkan-1.dll";
 constexpr char kVulkanLibName[] = "libvulkan.dylib";
 #elif DAWN_PLATFORM_IS(FUCHSIA)
 constexpr char kVulkanLibName[] = "libvulkan.so";
+#elif DAWN_PLATFORM_IS(SWITCH)
+// Unused on Switch: Vulkan (NVK) is linked statically and vkGetInstanceProcAddr
+// is resolved at link time (see VulkanInstance::Initialize below). Kept so the
+// unconditional references to kVulkanLibName still compile.
+constexpr char kVulkanLibName[] = "";
 #else
 #error "Unimplemented Vulkan backend platform"
 #endif
@@ -370,7 +375,12 @@ MaybeError VulkanInstance::Initialize(const InstanceBase* instance, ICD icd) {
 
     switch (icd) {
         case ICD::None: {
+#if DAWN_PLATFORM_IS(SWITCH)
+            // Vulkan (NVK) is linked statically on Horizon; nothing to dlopen.
+            (void)LoadVulkan;
+#else
             DAWN_TRY(LoadVulkan(kVulkanLibName));
+#endif
             // Succesfully loaded driver; break.
             break;
         }
diff --git a/src/dawn/native/vulkan/VulkanFunctions.cpp b/src/dawn/native/vulkan/VulkanFunctions.cpp
index 60b075dea..c385603ef 100644
--- a/src/dawn/native/vulkan/VulkanFunctions.cpp
+++ b/src/dawn/native/vulkan/VulkanFunctions.cpp
@@ -33,6 +33,14 @@
 #include "src/dawn/common/DynamicLib.h"
 #include "src/dawn/native/vulkan/VulkanInfo.h"
 
+#if DAWN_PLATFORM_IS(SWITCH)
+// Dawn compiles with VK_NO_PROTOTYPES, so vkGetInstanceProcAddr has no declaration.
+// On Horizon it is linked statically from NVK's libvulkan.a; declare it at file
+// scope (a language-linkage spec is illegal inside a function body).
+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vkGetInstanceProcAddr(
+    VkInstance instance, const char* pName);
+#endif
+
 namespace dawn::native::vulkan {
 
 namespace {
@@ -89,9 +97,18 @@ F AsVkFn(void(VKAPI_PTR* addr)()) {
     } while (0)
 
 MaybeError VulkanFunctions::LoadGlobalProcs(const DynamicLib& vulkanLib) {
+#if DAWN_PLATFORM_IS(SWITCH)
+    // No dynamic loader on Horizon: Vulkan (NVK) is linked statically, so the
+    // whole proc table bootstraps from the link-time vkGetInstanceProcAddr symbol.
+    // vkGetInstanceProcAddr is declared at file scope above and provided by NVK's
+    // static libvulkan.a at link time.
+    (void)vulkanLib;
+    GetInstanceProcAddr = &vkGetInstanceProcAddr;
+#else
     if (!vulkanLib.GetProc(&GetInstanceProcAddr, "vkGetInstanceProcAddr")) {
         return DAWN_INTERNAL_ERROR("Couldn't get vkGetInstanceProcAddr");
     }
+#endif
 
     GET_GLOBAL_PROC(CreateInstance);
     GET_GLOBAL_PROC(EnumerateInstanceExtensionProperties);
