diff --git a/src/dawn/common/DynamicLib.cpp b/src/dawn/common/DynamicLib.cpp
index d155e490d..ccd6de46d 100644
--- a/src/dawn/common/DynamicLib.cpp
+++ b/src/dawn/common/DynamicLib.cpp
@@ -38,7 +38,19 @@
 #include "src/dawn/common/WindowsUtils.h"
 #endif
 #elif DAWN_PLATFORM_IS(POSIX)
+#if DAWN_PLATFORM_IS(SWITCH)
+// Horizon/libnx has no dynamic loader. Vulkan (NVK) is linked statically and the
+// Switch code path never calls DynamicLib, but this TU must still compile — supply
+// always-failing dl* stubs instead of <dlfcn.h>.
+#define RTLD_NOW 0
+#define RTLD_NOLOAD 0
+inline void* dlopen(const char*, int) { return nullptr; }
+inline int dlclose(void*) { return 0; }
+inline void* dlsym(void*, const char*) { return nullptr; }
+inline const char* dlerror() { return "no dynamic loader on Horizon"; }
+#else
 #include <dlfcn.h>
+#endif
 #else
 #error "Unsupported platform for DynamicLib"
 #endif
