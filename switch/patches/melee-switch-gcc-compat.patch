diff --git a/src/pc/os.c b/src/pc/os.c
index 55cc86c..795cf05 100644
--- a/src/pc/os.c
+++ b/src/pc/os.c
@@ -344,9 +344,41 @@ void pc_platform_init(void) {
 #include <android/log.h>
 #endif
 
+#if defined(__SWITCH__)
+/* stdout/stderr are per-_reent (per-thread) FILE* on this newlib/libnx target
+ * (each thread's __getreent() gets its OWN copy, inherited by pointer-value
+ * from whichever thread created it -- confirmed via libnx's threadCreate()
+ * source). melee's worker threads (e.g. pc_file_cache_start_prewarm's
+ * background thread, src/pc/file_cache.cpp) call OSReport() concurrently with
+ * the main thread, and hardware testing showed this hitting a null devoptab
+ * entry inside newlib's _write_r/_lseek_r the first time a background thread
+ * touched stdout post-boot (Data Abort, address 0). Route OSReport/OSPanic
+ * through one explicitly-opened, mutex-serialized FILE* instead of stdout/
+ * stderr, so every thread always shares the exact same fd/devoptab state and
+ * writes never interleave. */
+#include <pthread.h>
+
+static pthread_mutex_t s_switch_log_mutex = PTHREAD_MUTEX_INITIALIZER;
+static FILE* s_switch_log_file;
+
+static void switch_log_vwrite(const char* msg, va_list list) {
+    pthread_mutex_lock(&s_switch_log_mutex);
+    if (!s_switch_log_file) {
+        s_switch_log_file = fopen("sdmc:/switch/melee-nx/melee-nx-runtime.log", "a");
+    }
+    if (s_switch_log_file) {
+        vfprintf(s_switch_log_file, msg, list);
+        fflush(s_switch_log_file);
+    }
+    pthread_mutex_unlock(&s_switch_log_mutex);
+}
+#endif
+
 void OSVReport(const char* msg, va_list list) {
 #if defined(__ANDROID__)
     __android_log_vprint(ANDROID_LOG_INFO, "OSReport", msg, list);
+#elif defined(__SWITCH__)
+    switch_log_vwrite(msg, list);
 #else
     vfprintf(stdout, msg, list);
     fflush(stdout);
