+/* MEM1's 4GB window.
+ *
+ * Hosts that can place MEM1 below 4GB leave these zero, the window is off, and
+ * a slot is a plain host address exactly as before. Horizon cannot: libnx maps
+ * its heap far above 4GB (0x1f_63xx_xxxx on hardware) and there is no way to
+ * ask for anything lower -- svcMapMemory only accepts a destination inside the
+ * kernel's stack region, which a 39-bit address space places below 4GB
+ * essentially never. So on Switch a slot instead means "offset inside whatever
+ * 4GB window MEM1 landed in", and pc_resolve_dp puts the high half back.
+ *
+ * This is what keeps the raw 32-bit relocation arithmetic correct without
+ * touching any of it -- HSD_ArchiveParse's Locate, axdriver's three table
+ * fixups, particle.c's three -- because inside a single window only the low 32
+ * bits ever differ. AllocMEM1 guarantees MEM1 does not straddle a boundary. */
+extern uintptr_t pc_mem1_hi; /* MEM1 base, low 32 bits cleared */
+extern uint32_t pc_mem1_lo;  /* MEM1 base, low 32 bits only */
+extern uint32_t pc_mem1_len; /* MEM1 size; 0 disables the window */
+
+void pc_disc_set_mem1_window(const void* base, uint32_t size);
+
+/* Whether p is a host address a 32-bit slot can hold. With the window off this
+ * is the original "fits in 32 bits" test. */
+static inline int pc_dp_in_window(const void* p) {
+    if (pc_mem1_len == 0) {
+        return !((uintptr_t)p >> 32);
+    }
+    return ((uintptr_t)p & ~(uintptr_t)0xFFFFFFFFu) == pc_mem1_hi &&
+           (uint32_t)(uintptr_t)p - pc_mem1_lo < pc_mem1_len;
+}
+
 static inline uint32_t pc_encode_dp(const void* p) {
     if (!p)
         return 0;
+    if (pc_dp_in_window(p)) {
+        return (uint32_t)(uintptr_t)p;
+    }
     if (!((uintptr_t)p >> 32)) {
         return (uint32_t)(uintptr_t)p;
     }
@@ -62,6 +95,12 @@ static inline void* pc_resolve_dp(uint32_t slot) {
     if ((slot & 0xFF000000u) == 0x02000000u) {
         return pc_resolve_ext_ptr(slot & 0x00FFFFFFu);
     }
+    /* Only slots inside MEM1's window get the high half back. Anything else is
+     * an ARAM offset -- the game tells those apart by being below 16MB, see
+     * PC_IS_ARAM_ADDR -- and has to stay the small integer it already is. */
+    if (pc_mem1_len != 0 && (uint32_t)(slot - pc_mem1_lo) < pc_mem1_len) {
+        return (void*)(pc_mem1_hi | (uintptr_t)slot);
+    }
     return (void*)(uintptr_t)slot;
 }
 
