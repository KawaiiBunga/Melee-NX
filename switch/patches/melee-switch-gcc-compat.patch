+ * aurora sink used to hold one too, which gave the file three independent
+ * append offsets (here, there, and redirect_stdio_to_sd's fd) that overwrote
+ * each other and silently truncated the log -- see main.c's switch_log_write()
+ * for the hardware evidence. One descriptor, one offset, one mutex. */
+#include <pthread.h>
+#include <unistd.h>
