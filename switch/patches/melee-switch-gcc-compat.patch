+#if defined(__SWITCH__)
+/* stdout/stderr are per-_reent (per-thread) FILE* on this newlib/libnx target,
+ * each thread getting its own copy inherited by pointer-value at thread-
+ * creation time. aurora/Dawn run plenty of their own worker threads (shader
+ * compilation, adapter/device enumeration), and hardware testing showed a
+ * background thread's first stdout write after boot hitting a null devoptab
+ * entry inside newlib (Data Abort, address 0) -- the same failure this fixed
+ * for melee's own OSReport() (see os.c's switch_log_vwrite). Route Aurora's
+ * log sink through the same kind of dedicated, mutex-serialized FILE* instead
+ * of stdout/stderr so it can't hit the same bug from a Dawn worker thread. */
+#include <pthread.h>
+
+static pthread_mutex_t s_switch_log_mutex = PTHREAD_MUTEX_INITIALIZER;
+static FILE* s_switch_log_file;
+
+static FILE* switch_log_file_locked(void) {
+    if (!s_switch_log_file) {
+        s_switch_log_file = fopen("sdmc:/switch/melee-nx/melee-nx-runtime.log", "a");
+    }
+    return s_switch_log_file;
+}
+#endif
