+#if defined(__SWITCH__)
+/* Every Switch log sink has to share ONE file offset.
+ *
+ * This sink used to own a private fopen("sdmc:/switch/melee-nx/melee-nx-runtime.log",
+ * "a"), and so did os.c's switch_log_vwrite(), while main_switch.cpp's
+ * redirect_stdio_to_sd() dup2()'d a third descriptor for the same path onto
+ * fd 1/2. Three handles, three independent file offsets, all appending: they
+ * overwrote each other, and the file ended up truncated to whatever the last
+ * handle to write had reached. Hardware-confirmed 2026-09-17 -- a run that
+ * demonstrably got into melee_main() (gmMain's file-cache prewarm was on the
+ * main thread's stack, and aurora's gfx render/pipeline workers were running,
+ * which only start once webgpu::initialize() has succeeded) left a 331-byte
+ * log that stopped at aurora's sixth line. Everything after that was lost,
+ * which is exactly the part worth reading.
+ *
+ * Write to fd 1 instead. redirect_stdio_to_sd() rebinds the RAW descriptor, so
+ * fd 1 is process-wide: one offset shared by every sink on every thread, and
+ * no per-_reent FILE* that could hit a stale devoptab from a Dawn worker (the
+ * original reason this sink avoided stdout -- see main_switch.cpp for why the
+ * fd-level redirect fixes that for good). write() also holds no newlib buffer,
+ * so a line has reached the SD card before the next one is formatted. */
+#include <pthread.h>
+#include <unistd.h>
+
+static pthread_mutex_t s_switch_log_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* Serialized so two threads' lines never interleave mid-line. */
+static void switch_log_write(const char* buf, size_t len) {
+    pthread_mutex_lock(&s_switch_log_mutex);
+    while (len > 0) {
+        const ssize_t n = write(STDOUT_FILENO, buf, len);
+        if (n <= 0) {
+            break;
+        }
+        buf += n;
+        len -= (size_t)n;
+    }
+    /* Commit to the SD card, not just to Horizon's FS cache. newlib's write()
+       reaches fsdev, which calls fsFileWrite with FsWriteOption_None; without
+       an fsFileFlush the bytes are dropped if the process dies before the file
+       is closed, which is exactly how both hardware runs on 2026-09-17 lost
+       every line after boot's first few. A bring-up trade: one SD commit per
+       log line is slow, and can be relaxed to a periodic flush once the port
+       stops dying with the interesting part of the log still in flight. */
+    fsync(STDOUT_FILENO);
+    pthread_mutex_unlock(&s_switch_log_mutex);
+}
+#endif
