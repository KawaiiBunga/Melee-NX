+    return SDL_Unsupported();
+}
+
+static Sint16 clamp_axis(int v)
+{
+    if (v > SDL_JOYSTICK_AXIS_MAX) {
+        v = SDL_JOYSTICK_AXIS_MAX;
+    } else if (v < SDL_JOYSTICK_AXIS_MIN) {
+        v = SDL_JOYSTICK_AXIS_MIN;
+    }
+    return (Sint16)v;
+}
+
+static void SWITCH_JoystickUpdate(SDL_Joystick *joystick)
+{
+    static u64 previous = 0;
+    Uint64 timestamp = SDL_GetTicksNS();
+
+    padUpdate(&g_pad);
+
+    u64 held = padGetButtons(&g_pad);
+    u64 changed = held ^ previous;
+    if (changed) {
+        for (int i = 0; i < NB_BUTTONS; i++) {
+            if (changed & button_map[i]) {
+                SDL_SendJoystickButton(timestamp, joystick, (Uint8)i,
+                                       (held & button_map[i]) ? true : false);
+            }
+        }
+    }
+    previous = held;
+
+    HidAnalogStickState l = padGetStickPos(&g_pad, 0);
+    HidAnalogStickState r = padGetStickPos(&g_pad, 1);
+    SDL_SendJoystickAxis(timestamp, joystick, 0, clamp_axis(l.x));
+    SDL_SendJoystickAxis(timestamp, joystick, 1, clamp_axis(-l.y));
+    SDL_SendJoystickAxis(timestamp, joystick, 2, clamp_axis(r.x));
+    SDL_SendJoystickAxis(timestamp, joystick, 3, clamp_axis(-r.y));
+}
+
+static void SWITCH_JoystickClose(SDL_Joystick *joystick)
+{
+}
+
+static void SWITCH_JoystickQuit(void)
+{
+}
