+static bool SWITCH_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+    out->a = (SDL_InputMapping){ EMappingKind_Button, 0 };
+    out->b = (SDL_InputMapping){ EMappingKind_Button, 1 };
+    out->x = (SDL_InputMapping){ EMappingKind_Button, 2 };
+    out->y = (SDL_InputMapping){ EMappingKind_Button, 3 };
+    out->leftshoulder = (SDL_InputMapping){ EMappingKind_Button, 6 };
+    out->rightshoulder = (SDL_InputMapping){ EMappingKind_Button, 7 };
+    out->lefttrigger = (SDL_InputMapping){ EMappingKind_Button, 4 };
+    out->righttrigger = (SDL_InputMapping){ EMappingKind_Button, 5 };
+    out->back = (SDL_InputMapping){ EMappingKind_Button, 8 };
+    out->start = (SDL_InputMapping){ EMappingKind_Button, 9 };
+    out->leftstick = (SDL_InputMapping){ EMappingKind_Button, 10 };
+    out->rightstick = (SDL_InputMapping){ EMappingKind_Button, 11 };
+    out->dpup = (SDL_InputMapping){ EMappingKind_Button, 12 };
+    out->dpdown = (SDL_InputMapping){ EMappingKind_Button, 13 };
+    out->dpleft = (SDL_InputMapping){ EMappingKind_Button, 14 };
+    out->dpright = (SDL_InputMapping){ EMappingKind_Button, 15 };
+    out->leftx = (SDL_InputMapping){ EMappingKind_Axis, 0 };
+    out->lefty = (SDL_InputMapping){ EMappingKind_Axis, 1 };
+    out->rightx = (SDL_InputMapping){ EMappingKind_Axis, 2 };
+    out->righty = (SDL_InputMapping){ EMappingKind_Axis, 3 };
+    return true;
+}
+
+SDL_JoystickDriver SDL_SWITCH_JoystickDriver = {
+    SWITCH_JoystickInit,
+    SWITCH_JoystickGetCount,
+    SWITCH_JoystickDetect,
+    SWITCH_JoystickIsDevicePresent,
+    SWITCH_JoystickGetDeviceName,
+    SWITCH_JoystickGetDevicePath,
+    SWITCH_JoystickGetDeviceSteamVirtualGamepadSlot,
+    SWITCH_JoystickGetDevicePlayerIndex,
+    SWITCH_JoystickSetDevicePlayerIndex,
+    SWITCH_JoystickGetDeviceGUID,
+    SWITCH_JoystickGetDeviceInstanceID,
+    SWITCH_JoystickOpen,
+    SWITCH_JoystickRumble,
+    SWITCH_JoystickRumbleTriggers,
+    SWITCH_JoystickSetLED,
+    SWITCH_JoystickSendEffect,
+    SWITCH_JoystickSetSensorsEnabled,
+    SWITCH_JoystickUpdate,
+    SWITCH_JoystickClose,
+    SWITCH_JoystickQuit,
+    SWITCH_JoystickGetGamepadMapping
+};
