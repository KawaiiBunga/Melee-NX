+#include "SDL_internal.h"
+
+#ifdef SDL_JOYSTICK_SWITCH
+
+// libnx (Nintendo Switch) joystick driver, using the HID pad API.
+
+#include <switch.h>
+
+#include "../SDL_sysjoystick.h"
+
+// Button index -> libnx HidNpadButton flag. The index order defines the
+// gamepad mapping below.
+static const u64 button_map[] = {
+    HidNpadButton_A,      // 0
+    HidNpadButton_B,      // 1
+    HidNpadButton_X,      // 2
+    HidNpadButton_Y,      // 3
+    HidNpadButton_L,      // 4
+    HidNpadButton_R,      // 5
+    HidNpadButton_ZL,     // 6
+    HidNpadButton_ZR,     // 7
+    HidNpadButton_Minus,  // 8
+    HidNpadButton_Plus,   // 9
+    HidNpadButton_StickL, // 10
+    HidNpadButton_StickR, // 11
+    HidNpadButton_Up,     // 12
+    HidNpadButton_Down,   // 13
+    HidNpadButton_Left,   // 14
+    HidNpadButton_Right,  // 15
+};
+#define NB_BUTTONS ((int)SDL_arraysize(button_map))
+
+static PadState g_pad;
+
+static bool SWITCH_JoystickInit(void)
+{
+    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+    padInitializeDefault(&g_pad);
+    SDL_PrivateJoystickAdded(1);
+    return true;
+}
+
+static int SWITCH_JoystickGetCount(void)
+{
+    return 1;
+}
+
+static void SWITCH_JoystickDetect(void)
+{
+}
+
