@@ -57,6 +57,10 @@
 #include <kernel/OS.h>
 #endif
 
+#ifdef SDL_PLATFORM_SWITCH
+#include <switch.h>
+#endif
+
 #ifdef HAVE_SIGNAL_H
 // List of signals to mask in the subthreads
 static const int sig_list[] = {
@@ -187,8 +191,69 @@ SDL_ThreadID SDL_GetCurrentThreadID(void)
 
 bool SDL_SYS_SetThreadPriority(SDL_ThreadPriority priority)
 {
-#if defined(SDL_PLATFORM_RISCOS) || defined(SDL_PLATFORM_SWITCH)
-    // RISC OS / Switch (libnx): pthread scheduler priority APIs are unavailable
+#if defined(SDL_PLATFORM_SWITCH)
+    /* devkitA64's pthread_setschedparam is ENOSYS, so this used to return true
+     * and do nothing -- every thread in the process, including background
+     * shader compilers, ran at exactly the main thread's priority and competed
+     * with it for the three cores Horizon gives an application. Go to the
+     * kernel directly instead.
+     *
+     * Horizon priorities are inverted: 0 is the highest, 0x3F the lowest, and
+     * an application may only move a thread within the band its process was
+     * granted, so the result is clamped rather than assumed.
+     *
+     * Offsets are relative to the MAIN thread's priority, not this thread's.
+     * Anchoring on self would drift: this is called repeatedly on the same
+     * thread (aurora's shader compiler moves between background and on-demand
+     * work), and each Low would subtract from the last. The main thread's
+     * priority is stable for the life of the process, which also keeps the
+     * offsets correct under hbloader's applet takeover and a title takeover
+     * alike instead of hardcoding 0x2C. */
+    s32 base = 0;
+    if (R_FAILED(svcGetThreadPriority(&base, envGetMainThreadHandle())) &&
+        R_FAILED(svcGetThreadPriority(&base, CUR_THREAD_HANDLE))) {
+        return true; /* Nothing to anchor on; leave the thread where it is. */
+    }
+
+    s32 current = 0;
+    if (R_FAILED(svcGetThreadPriority(&current, CUR_THREAD_HANDLE))) {
+        current = base;
+    }
+
+    int delta;
+    switch (priority) {
+    case SDL_THREAD_PRIORITY_LOW:
+        delta = +8; /* Spare time only. */
+        break;
+    case SDL_THREAD_PRIORITY_HIGH:
+        delta = -4;
+        break;
+    case SDL_THREAD_PRIORITY_TIME_CRITICAL:
+        delta = -8;
+        break;
+    case SDL_THREAD_PRIORITY_NORMAL:
+    default:
+        delta = 0;
+        break;
+    }
+
+    int target = (int)base + delta;
+    if (target < 0x1C) {
+        target = 0x1C;
+    } else if (target > 0x3B) {
+        target = 0x3B;
+    }
+    if ((u32)target == current) {
+        return true;
+    }
+    if (R_FAILED(svcSetThreadPriority(CUR_THREAD_HANDLE, (u32)target))) {
+        /* Outside the process's granted band. Not fatal: the thread simply
+         * keeps the priority it had. */
+        return true;
+    }
+    return true;
+#elif defined(SDL_PLATFORM_RISCOS)
+    // RISC OS: pthread scheduler priority APIs are unavailable
     return true;
 #else
     struct sched_param sched;
