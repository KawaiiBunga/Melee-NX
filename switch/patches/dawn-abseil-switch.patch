   return tm.tm_gmtoff;
@@ -117,6 +123,7 @@ auto tm_zone(const T& tm) -> decltype(tm.__tm_zone) {
   return tm.__tm_zone;
 }
 #endif  // tm_zone
+#endif  // __SWITCH__
 #endif
 using tm_gmtoff_t = decltype(tm_gmtoff(std::tm{}));
 
