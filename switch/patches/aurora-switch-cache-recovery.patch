+  const ImGuiIO& io = ImGui::GetIO();
+  ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f), ImGuiCond_Always,
+                          ImVec2(0.5f, 0.5f));
+  ImGui::SetNextWindowSize(ImVec2(io.DisplaySize.x * 0.7f, 0.f), ImGuiCond_Always);
+  constexpr ImGuiWindowFlags flags = ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize |
+                                     ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+                                     ImGuiWindowFlags_NoNav | ImGuiWindowFlags_AlwaysAutoResize;
+  if (ImGui::Begin("##launchwarm", nullptr, flags)) {
+    ImGui::SetWindowFontScale(2.4f);
+    ImGui::TextUnformatted("Preparing shaders");
+    ImGui::SetWindowFontScale(1.6f);
+    const float fraction = total > 0 ? static_cast<float>(done) / static_cast<float>(total) : 1.f;
+    char label[64];
+    std::snprintf(label, sizeof(label), "%lld / %lld", static_cast<long long>(done), static_cast<long long>(total));
+    ImGui::ProgressBar(fraction, ImVec2(-1.f, 48.f), label);
+    char note[64];
+    std::snprintf(note, sizeof(note), "%.0f s elapsed", elapsed);
+    ImGui::TextUnformatted(note);
+    ImGui::Spacing();
+    ImGui::TextUnformatted("Press any button to skip.");
+    ImGui::TextUnformatted("While shaders compile in the background the game may stutter.");
+  }
+  ImGui::End();
+}
+
+// Small corner popup shown over the game after the launch screen was skipped.
+static void draw_launch_warm_popup(int64_t done, int64_t total) {
+  ImGui::SetNextWindowPos(ImVec2(12.f, 12.f), ImGuiCond_Always);
+  ImGui::SetNextWindowBgAlpha(0.65f);
+  constexpr ImGuiWindowFlags flags = ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove |
+                                     ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoNav |
+                                     ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoFocusOnAppearing |
+                                     ImGuiWindowFlags_AlwaysAutoResize;
+  if (ImGui::Begin("##launchwarmpopup", nullptr, flags)) {
+    ImGui::SetWindowFontScale(1.3f);
+    ImGui::Text("Shaders compiling %lld / %lld", static_cast<long long>(done), static_cast<long long>(total));
+  }
+  ImGui::End();
+}
