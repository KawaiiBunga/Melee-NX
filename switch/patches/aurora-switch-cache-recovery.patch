+static bool launch_warm_skip_pressed(const AuroraEvent& event) {
+  if (event.type != AURORA_SDL_EVENT) {
+    return false;
+  }
+  switch (event.sdl.type) {
+  case SDL_EVENT_GAMEPAD_BUTTON_DOWN:
+  case SDL_EVENT_JOYSTICK_BUTTON_DOWN:
+    return true;
+  case SDL_EVENT_KEY_DOWN:
+    return !event.sdl.key.repeat;
+  default:
+    return false;
+  }
+}
+
+// Startup waits here until every descriptor a draw on this device has needed is
+// compiled, showing progress, unless the user skips. Those are queued first, so
+// this is the front of the background queue; the rest of the seed keeps warming
+// once the game runs.
+static void run_launch_warm() {
+  if (!g_launchWarmActive.load(std::memory_order_relaxed)) {
+    return;
+  }
+  const int64_t total = g_launchWarmTotal;
+
+  // Measured on hardware: three compile workers plus the progress frames managed
+  // about 9 pipelines/s (350 ms each); one worker alone manages 20-25/s. Extra
+  // workers are opt-in (perf.cfg warm_helpers) until they are shown to scale.
+  int helpers = 0;
+  if (const char* value = std::getenv("AURORA_LAUNCH_WARM_HELPERS")) {
+    helpers = std::clamp(std::atoi(value), 0, 2);
+  }
+  for (int i = 0; i < helpers; ++i) {
+    g_launchWarmWorkers.emplace_back([] { pipeline_worker(0, true); });
+  }
+  g_pipelineQueueCv.notify_all();
+  Log.info("LAUNCHWARM compiling {} pipelines used on this device with {} workers", total, helpers + 1);
+
+  const auto start = std::chrono::steady_clock::now();
+  auto lastReport = start;
+  bool skipped = false;
+  while (g_launchWarmRemaining.load(std::memory_order_relaxed) > 0 && !g_pipelineThreadEnd && !skipped) {
+    const auto now = std::chrono::steady_clock::now();
+    const double elapsed = std::chrono::duration<double>(now - start).count();
+    const int64_t done = total - g_launchWarmRemaining.load(std::memory_order_relaxed);
+    if (now - lastReport >= std::chrono::seconds(2)) {
+      lastReport = now;
+      Log.info("LAUNCHWARM ready {}/{} after {:.0f}s", done, total, elapsed);
+    }
+    for (const AuroraEvent* event = aurora_update(); event != nullptr && event->type != AURORA_NONE; ++event) {
+      if (event->type == AURORA_EXIT) {
+        std::exit(0);
+      }
+      // Ignore the press that launched the app.
+      if (elapsed > 1.5 && launch_warm_skip_pressed(*event)) {
+        skipped = true;
+      }
+    }
+    if (aurora_begin_frame()) {
+      draw_launch_warm_screen(done, total, elapsed);
+      aurora_end_frame();
+      // Roughly 8 progress frames a second: the screen needs no more, and every
+      // frame costs compile time on a three-core machine.
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    } else {
+      std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    }
+  }
+
+  const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+  const int64_t left = g_launchWarmRemaining.load(std::memory_order_relaxed);
+  if (left > 0 && skipped) {
+    Log.info("LAUNCHWARM skipped at {}/{} after {:.1f}s; compiling continues behind the game", total - left, total,
+             seconds);
+    g_launchWarmSkipped.store(true, std::memory_order_relaxed);
+    // Behind the game the rest is paced like any background work: helpers stop and the
+    // flat-out mode ends. A draw that must wait for its pipeline then has the CPU to
+    // itself instead of queueing behind compiles nobody is waiting for.
+    g_launchWarmActive.store(false, std::memory_order_relaxed);
+    g_pipelineQueueCv.notify_all();
+    for (auto& worker : g_launchWarmWorkers) {
+      worker.join();
+    }
+    g_launchWarmWorkers.clear();
+    return;
+  }
+  g_launchWarmActive.store(false, std::memory_order_relaxed);
+  g_pipelineQueueCv.notify_all();
+  for (auto& worker : g_launchWarmWorkers) {
+    worker.join();
+  }
+  g_launchWarmWorkers.clear();
+  Log.info("LAUNCHWARM done: {}/{} compiled in {:.1f}s", total - left, total, seconds);
+}
+
+// After a skip: draw the popup until the warm-up finishes, then release the helpers.
+static void update_launch_warm_popup() {
+  const int64_t left = g_launchWarmRemaining.load(std::memory_order_relaxed);
+  if (left > 0) {
+    draw_launch_warm_popup(g_launchWarmTotal - left, g_launchWarmTotal);
+    return;
+  }
+  g_launchWarmSkipped.store(false, std::memory_order_relaxed);
+  Log.info("LAUNCHWARM finished behind the game: {}/{} compiled", g_launchWarmTotal, g_launchWarmTotal);
+}
