+namespace {
+constexpr uint32_t kCurThreadHandle = 0xFFFF8000u;
+constexpr uint32_t kCurProcessHandle = 0xFFFF8001u;
+constexpr uint32_t kInfoCoreMask = 0u;
+// Confine the caller to the highest core the process is allowed, alone. A cold
+// vkCreateGraphicsPipeline holds a core for its whole duration and cannot be
+// cooperatively yielded, so an unpinned Low-priority compiler still steals a
+// core from the game or FIFO thread mid-frame -- the telemetry's sim spikes
+// track compile bursts one-for-one. Pinning breaks that coupling: the compiler
+// gets the top core and the game/FIFO/render threads keep the rest.
+//
+// Returns true if the compiler now owns a core of its own. That fact matters to
+// the pre-warm pacing: once the compiler is confined to a spare core it can no
+// longer steal cycles from the game/FIFO threads, so throttling the background
+// seed on frame time (see BackgroundFrameBudgetNs) stops protecting anything and
+// only leaves ~6,500 pipelines forever uncompiled -- every new scene then skips
+// the draws whose pipeline never got built. Pinned, we drain the seed flat out.
+// Number of cores this process is allowed to run on (Switch homebrew: usually 3,
+// mask 0x7). Used to refuse a second compile worker when there is no spare core
+// for it beyond the game core (0) and the primary compiler's core.
+int allowed_core_count() {
+  uint64_t mask = 0;
+  if (svcGetInfo(&mask, kInfoCoreMask, kCurProcessHandle, 0) != 0 || mask == 0) {
+    return 0;
+  }
+  int n = 0;
+  for (int i = 0; i < 32; ++i) {
+    if (((mask >> i) & 1u) != 0) {
+      ++n;
+    }
+  }
+  return n;
+}
+
+// Confine the caller to the rank-th highest allowed core, alone (rank 0 = the top
+// core, rank 1 = the next one down). rank 0 is the primary compiler; an optional
+// secondary compiler takes rank 1 so the two never share a core with each other,
+// and neither shares the game thread's core (0).
+bool pin_compiler_to_spare_core(int rank = 0) {
+  uint64_t mask = 0;
+  if (svcGetInfo(&mask, kInfoCoreMask, kCurProcessHandle, 0) != 0 || mask == 0) {
+    return false;
+  }
+  int core = 31, seen = 0;
+  for (; core >= 0; --core) {
+    if (((mask >> core) & 1u) != 0) {
+      if (seen++ == rank) {
+        break;
+      }
+    }
+  }
+  if (core < 0) {
+    return false;
+  }
+  return svcSetThreadCoreMask(kCurThreadHandle, core, 1u << core) == 0;
+}
+} // namespace
