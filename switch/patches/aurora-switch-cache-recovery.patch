+
+// Confine the caller to the rank-th highest allowed core, alone (rank 0 = the top
+// core, rank 1 = the next one down). rank 0 is the primary compiler; an optional
+// secondary compiler takes rank 1 so the two never share a core with each other,
+// and neither shares the game thread's core (0).
+bool pin_compiler_to_spare_core(int rank = 0) {
+  uint64_t mask = 0;
+  if (svcGetInfo(&mask, kInfoCoreMask, kCurProcessHandle, 0) != 0 || mask == 0) {
+    return false;
+  }
