+// The descriptor seed is derived data, like the dawn cache. A database torn by
+// an unclean exit used to poison every later launch; quarantine it once and
+// rebuild rather than losing pipeline warm-up permanently.
+static bool quarantine_pipeline_cache_file(const std::string& path) {
+  const auto bad = path + ".corrupt";
+  const auto journal = path + "-journal";
+  const auto lock = path + ".lock";
+
+  std::remove(bad.c_str());
+  if (std::rename(path.c_str(), bad.c_str()) != 0) {
+    if (std::remove(path.c_str()) != 0) {
+      Log.error("Failed to quarantine unreadable pipeline cache at '{}'", path);
+      return false;
+    }
+    Log.warn("Deleted unreadable pipeline cache '{}' (could not rename it aside)", path);
+  } else {
+    Log.warn("Quarantined unreadable pipeline cache to '{}'; rebuilding", bad);
+  }
+  // Both belong to the file that just moved.
+  std::remove(journal.c_str());
+  std::remove(lock.c_str());
+  return true;
+}
+
