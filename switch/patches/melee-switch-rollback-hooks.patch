+static int melee_nx_rb_safe(int scene_ending)
+{
+    /* The self-test never runs in an online match, which keeps its own savestates. */
+    return !scene_ending && !melee_nx_online_active() && !HSD_DevComIsBusy(0) && !HSD_DevComIsBusy(1) &&
+           !HSD_DevComIsBusy(2) && !HSD_DevComIsBusy(3);
+}
+/* Slippi's gameplay checksum, as Melee Unlocked computes it (shim/mu_online.c compute_checksum):
+ * every fighter's action, position and percent, and every player's stocks; plus the RNG seed. */
+static u32 melee_nx_rb_float_bits(float f)
+{
+    u32 v;
+    memcpy(&v, &f, 4);
+    return v;
+}
+static u32 melee_nx_rb_checksum(void)
+{
+    u32 acc = 0;
+    float sum = 0.0F;
+    int i, k;
+    for (i = 0; i < 4; i++) {
+        for (k = 0; k < 2; k++) {
+            HSD_GObj* gobj = player_slots[i].player_entity[k];
+            Fighter* fp;
+            if (gobj == NULL) {
+                continue;
+            }
+            fp = gobj->user_data;
+            acc ^= (u32) fp->motion_id;
+            acc ^= melee_nx_rb_float_bits(fp->cur_pos.x);
+            acc ^= melee_nx_rb_float_bits(fp->cur_pos.y);
+            acc ^= melee_nx_rb_float_bits(fp->dmg.x1830_percent);
+            acc ^= (u32) fp->x8_spawnNum;
+            sum = sum + fp->cur_pos.x;
+            sum = sum + fp->cur_pos.y;
+            sum = sum + fp->dmg.x1830_percent;
+        }
+        acc ^= (u8) player_slots[i].stocks;
+    }
+    acc ^= *HSD_RandSeedPtr;
+    return (((acc >> 16) ^ (acc & 0xFFFF)) << 16) | ((u32) (s32) sum & 0xFFFF);
+}
