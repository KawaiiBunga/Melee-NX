+
+/* Slippi online, InitPause (Unranked): Start does not pause. A human port with stocks holding
+ * L+R+A+Start ends the match as LRAS, on both games, since it is read from the synced pads; a
+ * local Start tap only toggles the pause display. */
+static bool melee_nx_lras_display;
+
+static int melee_nx_online_lras_check(void)
+{
+    const u32 lras = HSD_PAD_L | HSD_PAD_R | HSD_PAD_A | HSD_PAD_START;
+    int i, local;
+    for (i = 0; i < 4; i++) {
+        if (Player_GetPlayerSlotType(i) != Gm_PKind_Human || Player_GetStocks(i) == 0) {
+            continue;
+        }
+        if ((HSD_PadMasterStatus[i].button & lras) == lras) {
+            controller.state.pauser = (s8) i;
+            controller.state.match_result = 7;
+            controller.start.xD = 30;
+            ifAll_802F3394();
+            gm_801A10FC(i);
+            return -1;
+        }
+    }
+    local = melee_nx_online_local_port();
+    if (local < 0) {
+        return -1;
+    }
+    if (melee_nx_lras_display) {
+        if (Player_GetStocks(local) == 0 || (HSD_PadMasterStatus[local].trigger & HSD_PAD_START)) {
+            melee_nx_lras_display = false;
+            ifAll_802F33CC();
+            gm_801A10FC(local);
+        }
+    } else if (Player_GetStocks(local) != 0 && (HSD_PadMasterStatus[local].trigger & HSD_PAD_START)) {
+        melee_nx_lras_display = true;
+        ifAll_802F3394();
+        gm_801A0FEC(local, 5);
+        lbAudioAx_80024030(5);
+    }
+    return -1;
+}
