+/* Slippi's "Common/FastForward/DynamicsFix" (Required in Slippi Online): every joint of the
+ * fighter's tree that is dirty and not user-defined is set up, a joint, then its children, then
+ * its next sibling. After it the fighter's matrices are current on every frame its dynamics run;
+ * without it, gameplay reading a raw matrix before the draw saw the previous frame's. */
+static void melee_nx_dynamics_fix(HSD_JObj* jobj)
+{
+    for (; jobj != NULL; jobj = jobj->next) {
+        if (HSD_JObjMtxIsDirty(jobj)) {
+            HSD_JObjSetupMatrixSub(jobj);
+        }
+        melee_nx_dynamics_fix(jobj->child);
+    }
+}
