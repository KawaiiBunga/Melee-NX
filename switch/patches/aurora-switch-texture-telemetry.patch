+// Cheap bounded content signature: samples ~1 KB regardless of texture size so
+// the per-frame object-cache hit path can detect an in-place content change
+// (e.g. a THP video plane re-decoded into the same buffer) without hashing the
+// whole texture. A real image mutation changes at least one of the spread
+// samples; a false match on genuinely different content is astronomically
+// unlikely. Cost is a few hundred bytes of XXH3 per bind vs. multiple MB before.
+uint64_t quick_texture_sig(const void* data, size_t size) noexcept {
+  if (data == nullptr || size == 0) {
+    return 0;
+  }
+  if (size <= 1024) {
+    return XXH3_64bits(data, size);
+  }
+  const auto* p = static_cast<const uint8_t*>(data);
+  const uint64_t parts[6] = {
+      static_cast<uint64_t>(size),          XXH3_64bits(p, 256),
+      XXH3_64bits(p + size / 4, 256),       XXH3_64bits(p + size / 2, 256),
+      XXH3_64bits(p + (size * 3) / 4, 256), XXH3_64bits(p + size - 256, 256),
+  };
+  return XXH3_64bits(parts, sizeof(parts));
+}
