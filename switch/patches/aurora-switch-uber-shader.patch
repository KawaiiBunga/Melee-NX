+// AURORA_UBER (perf.cfg `uber`): 0 off, 1 draw with the uber-shader while a draw's
+// specialised pipeline is still compiling, 2 always use it where it applies.
+inline int uber_configured_mode() noexcept {
+  static const int mode = [] {
+    const char* value = std::getenv("AURORA_UBER");
+    return value != nullptr ? std::atoi(value) : 0;
+  }();
+  return mode;
+}
+// Set when frames collapse while uber draws are on screen: the uber-shader is then off
+// for the rest of the run (see begin_pipeline_frame). Draws go back to waiting for their
+// specialised pipeline.
+inline std::atomic<bool>& uber_tripped_flag() noexcept {
+  static std::atomic<bool> flag{false};
+  return flag;
+}
+inline bool uber_tripped() noexcept { return uber_tripped_flag().load(std::memory_order_relaxed); }
+// Uber draws recorded since the main thread last looked.
+inline std::atomic<uint32_t>& uber_frame_draws() noexcept {
+  static std::atomic<uint32_t> count{0};
+  return count;
+}
+inline int uber_mode() noexcept { return uber_tripped() ? 0 : uber_configured_mode(); }
+// An uber pipeline keeps the fixed-function state of the config it stands in for
+// and replaces its shader key with a marker no generated shader can have.
+inline bool is_uber_config(const PipelineConfig& config) noexcept {
+  return config.shaderConfig.fogType == 0xFD && config.shaderConfig.vtxStride == 0xFE;
+}
+inline PipelineConfig uber_pipeline_config(const PipelineConfig& config) noexcept {
+  PipelineConfig uber = config;
+  uber.shaderConfig = {};
+  uber.shaderConfig.fogType = 0xFD;
+  uber.shaderConfig.vtxStride = 0xFE;
+  return uber;
+}
+wgpu::ShaderModule build_uber_shader() noexcept;
+
 wgpu::RenderPipeline create_pipeline([[maybe_unused]] const PipelineConfig& config);
