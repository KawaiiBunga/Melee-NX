+bool uber_supports(const ShaderConfig& config, const ShaderInfo& info) noexcept {
+  if (config.lineMode != 0 || info.zTexStage >= 0) {
+    return false;
+  }
+  if (config.tevStageCount == 0 || config.tevStageCount > melee_nx::uber::MaxTevStagesSupported ||
+      config.numIndStages != 0) {
+    return false;
+  }
+  for (u32 i = 0; i < config.tevStageCount; ++i) {
+    const auto& stage = config.tevStages[i];
+    if (stage.indTexMtxId != GX_ITM_OFF || stage.indTexWrapS != GX_ITW_OFF || stage.indTexWrapT != GX_ITW_OFF ||
+        stage.indTexAddPrev || is_alpha_bump_channel(stage.channelId)) {
+      return false;
+    }
+  }
+  for (u32 i = 0; i < config.tcgs.size(); ++i) {
+    if (!info.sampledTexCoords.test(i)) {
+      continue;
+    }
+    const auto& tcg = config.tcgs[i];
+    if (tcg.type != GX_TG_MTX3x4 && tcg.type != GX_TG_MTX2x4 && tcg.type != GX_TG_SRTG) {
+      return false;
+    }
+    const bool srcOk = tcg.src == GX_TG_POS || tcg.src == GX_TG_NRM || tcg.src == GX_TG_COLOR0 ||
+                       tcg.src == GX_TG_COLOR1 || (tcg.src >= GX_TG_TEX0 && tcg.src <= GX_TG_TEX7);
+    if (!srcOk) {
+      return false;
+    }
+  }
+  const auto& nrm = config.attrs[GX_VA_NRM];
+  if (nrm.attrType != GX_NONE && (nrm.cnt != 3 || nrm.nbt3)) {
+    return false;
+  }
+  for (u32 a = GX_VA_POS; a <= GX_VA_TEX7; ++a) {
+    const auto& attr = config.attrs[a];
+    const bool color = a == GX_VA_CLR0 || a == GX_VA_CLR1;
+    if (attr.attrType == GX_NONE) {
+      continue;
+    }
+    if ((color && attr.compType > GX_RGBA8) || (!color && attr.compType > GX_F32)) {
+      return false;
+    }
+  }
+  return true;
+}
