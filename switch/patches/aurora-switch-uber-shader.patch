+    setu(U_TCG + i, 2, static_cast<u32>(tcg.mtx));
+    setu(U_TCG + i, 3, (static_cast<u32>(tcg.postMtx) & 0xFFu) | (tcg.normalize ? 1u << 8 : 0u));
+  }
+  const auto nibble = [](u32 value) { return value == 0xFFu ? 15u : (value & 15u); };
+  for (u32 s = 0; s < config.tevStageCount; ++s) {
+    const auto& stage = config.tevStages[s];
+    const u32 w0 = static_cast<u32>(stage.colorPass.a) | (static_cast<u32>(stage.colorPass.b) << 4) |
+                   (static_cast<u32>(stage.colorPass.c) << 8) | (static_cast<u32>(stage.colorPass.d) << 12) |
+                   (static_cast<u32>(stage.alphaPass.a) << 16) | (static_cast<u32>(stage.alphaPass.b) << 19) |
+                   (static_cast<u32>(stage.alphaPass.c) << 22) | (static_cast<u32>(stage.alphaPass.d) << 25);
+    const u32 w1 = static_cast<u32>(stage.colorOp.op) | (static_cast<u32>(stage.colorOp.bias) << 4) |
+                   (static_cast<u32>(stage.colorOp.scale) << 6) | (static_cast<u32>(stage.colorOp.outReg) << 8) |
+                   (stage.colorOp.clamp ? 1u << 10 : 0u) | (static_cast<u32>(stage.alphaOp.op) << 16) |
+                   (static_cast<u32>(stage.alphaOp.bias) << 20) | (static_cast<u32>(stage.alphaOp.scale) << 22) |
+                   (static_cast<u32>(stage.alphaOp.outReg) << 24) | (stage.alphaOp.clamp ? 1u << 26 : 0u);
+    const u32 w2 = static_cast<u32>(stage.kcSel) | (static_cast<u32>(stage.kaSel) << 8) |
+                   (nibble(stage.texCoordId) << 16) | (nibble(stage.texMapId) << 20) |
+                   (nibble(stage.channelId) << 24) | (static_cast<u32>(stage.tevSwapRas) << 28) |
+                   (static_cast<u32>(stage.tevSwapTex) << 30);
+    setu(U_TEV + s, 0, w0);
+    setu(U_TEV + s, 1, w1);
+    setu(U_TEV + s, 2, w2);
+  }
+
+  static ByteBuffer buf;
+  buf.clear();
+  buf.append(f.data(), f.size() * sizeof(float));
+  buf.append(u.data(), u.size() * sizeof(u32));
+  return gfx::push_uniform(buf.data(), buf.size());
+}
+
 } // namespace aurora::gx
