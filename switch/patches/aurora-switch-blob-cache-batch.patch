+// Most recent write for this key, or nullptr. Caller holds cache_mutex.
+static const PendingCacheWrite* find_pending_write(const XXH128_hash_t& key) {
+  for (auto it = pending_writes.rbegin(); it != pending_writes.rend(); ++it) {
+    if (it->key.low64 == key.low64 && it->key.high64 == key.high64) {
+      return &*it;
+    }
+  }
+  return nullptr;
