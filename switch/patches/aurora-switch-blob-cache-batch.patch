+
+// Commit every buffered blob in one transaction. Caller holds cache_mutex.
+static bool flush_pending_writes_locked() {
+  if (pending_writes.empty()) {
+    return true;
+  }
+  // Whatever happens below, do not keep retrying the same batch: these are
+  // derived blobs and dropping them only costs a recompile later.
+  struct Clear {
+    ~Clear() {
+      pending_writes.clear();
+      pending_write_bytes = 0;
+    }
+  } clearOnExit;
+
+  if (!cache_init()) {
+    return false;
+  }
+
+  sqlite::Transaction tx(db, Log, true);
+  if (!tx) {
+    Log.error("Failed to open batched store transaction");
+    return false;
+  }
+
+  for (const auto& write : pending_writes) {
+    check(sqlite3_bind_blob64(store_stmt, 1, &write.key, sizeof(write.key), SQLITE_TRANSIENT));
+    check(sqlite3_bind_blob64(store_stmt, 2, write.stored.data(), write.stored.size(), SQLITE_STATIC));
+    check(sqlite3_bind_int64(store_stmt, 3, static_cast<sqlite3_int64>(write.originalSize)));
+    check(sqlite3_bind_int(store_stmt, 4, write.compressed));
+    const auto ret = sqlite3_step(store_stmt);
+    sqlite3_reset(store_stmt);
+    if (ret != SQLITE_DONE) {
+      Log.error("Failed to insert cache row: {}", sqlite3_errmsg(db));
+      return false;
+    }
+  }
+  check(sqlite3_clear_bindings(store_stmt));
+
+  tx.commit();
+  return true;
+}
+
+void cache_flush() {
+  std::lock_guard lock(cache_mutex);
+  flush_pending_writes_locked();
+}
+
+// Most recent write for this key, or nullptr. Caller holds cache_mutex.
+static const PendingCacheWrite* find_pending_write(const XXH128_hash_t& key) {
+  for (auto it = pending_writes.rbegin(); it != pending_writes.rend(); ++it) {
+    if (it->key.low64 == key.low64 && it->key.high64 == key.high64) {
+      return &*it;
+    }
+  }
+  return nullptr;
 }
 
