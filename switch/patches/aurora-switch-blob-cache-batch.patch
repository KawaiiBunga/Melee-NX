+static bool decode_blob(void* output, size_t size, const void* stored, size_t storedSize, bool compressed) {
+  if (!stored || !size) return false;
+  if (!compressed) {
+    if (storedSize != size) {
+      Log.error("Raw cache entry size mismatch: expected {}, got {}", size, storedSize);
+      return false;
+    }
+    std::memcpy(output, stored, size);
+    return true;
+  }
+#if defined(AURORA_CACHE_USE_ZSTD)
+  const auto result = ZSTD_decompress(output, size, stored, storedSize);
+  if (!ZSTD_isError(result) && result == size) return true;
+#endif
+  Log.error("Cache entry decompression failed or size mismatched");
+  return false;
+}
