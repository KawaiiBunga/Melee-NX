+// Size queries materialize a bounded decoded entry once. The subsequent copy
+// reuses it without SELECT, a read transaction, SD pages or decompression.
+// Oversized entries retain the size/copy protocol without filling RAM.
+static size_t load_blob_locked(const void* key, size_t keySize, void* value, size_t valueSize) {
+  if (!cache_init()) return 0;
+  const auto hash = XXH128(key, keySize, 0);
+  const auto copy = [&](const std::vector<uint8_t>& decoded) {
+    if (value && valueSize == decoded.size()) {
+      std::memcpy(value, decoded.data(), decoded.size());
+      cache_keys_used.push_back(hash);
+    }
+    return decoded.size();
+  };
+  if (const auto* cached = read_cache.find(hash.low64, hash.high64, key, keySize)) {
+    ++s_blobRamHits;
+    return copy(*cached);
+  }
+  const auto load = [&](size_t size, const void* stored, size_t storedSize, bool compressed) -> size_t {
+    if (!size) return 0;
+    // A caller with a wrong-sized output must not have that output touched.
+    if (value && valueSize != size) return size;
+    if (read_cache.accepts(keySize, size)) {
+      const auto* cached = read_cache.fill(hash.low64, hash.high64, key, keySize, size,
+          [&](void* out, size_t count) { return decode_blob(out, count, stored, storedSize, compressed); });
+      return cached ? copy(*cached) : 0;
+    }
+    if (value) {
+      if (!decode_blob(value, size, stored, storedSize, compressed)) return 0;
+      cache_keys_used.push_back(hash);
+    }
+    return size;
+  };
+  // Stores invalidate the RAM entry before becoming visible in this buffer.
+  if (const auto* pending = find_pending_write(hash)) {
+    return load(pending->originalSize, pending->stored.data(), pending->stored.size(), pending->compressed != 0);
+  }
+  // One SELECT has its own SQLite read snapshot until reset; an explicit
+  // BEGIN/ROLLBACK around the same single statement adds no consistency.
+  struct Reset {
+    ~Reset() { sqlite3_reset(load_stmt); sqlite3_clear_bindings(load_stmt); }
+  } reset;
+  if (check(sqlite3_bind_blob(load_stmt, 1, &hash, sizeof(hash), SQLITE_TRANSIENT)) != SQLITE_OK) return 0;
+  ++s_blobSqlReads;
+  const auto result = sqlite3_step(load_stmt);
+  if (result == SQLITE_DONE) return 0;
+  if (result != SQLITE_ROW) {
+    Log.error("Looking up cache key failed: {}", sqlite3_errmsg(db));
+    return 0;
+  }
+  const auto signedSize = sqlite3_column_int64(load_stmt, 1);
+  if (signedSize <= 0) return 0;
+  const size_t size = static_cast<size_t>(signedSize);
+  if ((value && valueSize != size) || (!value && !read_cache.accepts(keySize, size))) return size;
+  const auto* stored = sqlite3_column_blob(load_stmt, 0);
+  const auto storedSize = static_cast<size_t>(sqlite3_column_bytes(load_stmt, 0));
+  return load(size, stored, storedSize, sqlite3_column_int(load_stmt, 2) != 0);
+}
