+size_t load_from_cache(const void* key, size_t keySize, void* value, size_t valueSize, void*) {
+  const auto waiting = std::chrono::steady_clock::now();
+  std::lock_guard lock(cache_mutex);
+  const auto start = std::chrono::steady_clock::now();
+  const size_t result = load_blob_locked(key, keySize, value, valueSize);
+  const auto now = std::chrono::steady_clock::now();
+  s_blobLockNs += std::chrono::duration_cast<std::chrono::nanoseconds>(start - waiting).count();
+  s_blobLookupNs += std::chrono::duration_cast<std::chrono::nanoseconds>(now - start).count();
+  ++s_blobLookupCount;
+  if (!value) {
+    if (result) { ++s_blobHits; s_blobHitKb += result / 1024; }
+    else ++s_blobMisses;
+  }
+  if (s_blobStatPrev.time_since_epoch().count() == 0) s_blobStatPrev = now;
+  if (now - s_blobStatPrev >= std::chrono::seconds(2)) {
+    Log.info("BLOBCACHE hits {} misses {} hit_kb {} lookups {} avg_lookup_ms {:.2f} over {}ms "
+             "ram_hits {} sql_reads {} ram_kb {} evictions {} avg_lock_ms {:.2f}",
+             s_blobHits, s_blobMisses, s_blobHitKb, s_blobLookupCount,
+             (s_blobLookupNs / 1e6) / s_blobLookupCount,
+             std::chrono::duration_cast<std::chrono::milliseconds>(now - s_blobStatPrev).count(),
+             s_blobRamHits, s_blobSqlReads, read_cache.bytes() / 1024, read_cache.evictions(),
+             (s_blobLockNs / 1e6) / s_blobLookupCount);
+    s_blobHits = s_blobMisses = s_blobHitKb = s_blobLookupNs = s_blobLookupCount = s_blobLockNs = 0;
+    s_blobRamHits = s_blobSqlReads = 0;
+    s_blobStatPrev = now;
+  }
+  return result;
+}
