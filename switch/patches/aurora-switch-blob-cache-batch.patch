+    s_blobStatPrev = now;
+    return;
+  }
+  if (now - s_blobStatPrev >= std::chrono::seconds(2)) {
+    Log.info("BLOBCACHE hits {} misses {} hit_kb {} lookups {} avg_lookup_ms {:.2f} over {}ms", s_blobHits,
