+// The dawn cache is derived data: everything in it can be recompiled. Until
+// now a single torn write disabled it permanently, because every later launch
+// failed the same PRAGMA and set cache_broken -- so every pipeline was compiled
+// from scratch on first use, forever. Move the unreadable file aside once and
+// start a fresh database instead. The bad copy is kept for diagnosis, not
+// silently deleted.
+static bool quarantine_cache_file() {
+  const auto path = io::fs_path_to_string(cache_path());
+  const auto bad = path + ".corrupt";
+  const auto journal = path + "-journal";
+
+  std::remove(bad.c_str());
+  if (std::rename(path.c_str(), bad.c_str()) != 0) {
+    if (std::remove(path.c_str()) != 0) {
+      Log.error("Failed to quarantine unreadable dawn cache at '{}'", path);
+      return false;
+    }
+    Log.warn("Deleted unreadable dawn cache '{}' (could not rename it aside)", path);
+  } else {
+    Log.warn("Quarantined unreadable dawn cache to '{}'; rebuilding", bad);
+  }
+  // The rollback journal describes the file that just moved; it must not be
+  // replayed into the replacement.
+  std::remove(journal.c_str());
+  return true;
