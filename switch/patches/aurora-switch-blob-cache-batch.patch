+             std::chrono::duration_cast<std::chrono::milliseconds>(now - s_blobStatPrev).count());
+    s_blobHits = s_blobMisses = s_blobHitKb = s_blobMissKb = 0;
+    s_blobLookupNs = s_blobLookupCount = 0;
+    s_blobStatPrev = now;
+  }
