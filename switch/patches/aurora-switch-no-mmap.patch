+  // Runs `fn` on the worker thread, blocking the caller until it completes.
+  // Switch-only: devkitA64/libnx's newlib stdio faults (Data Abort in
+  // _lseek_r/_read_r, devoptab_list[dev]==NULL) when a FILE/SDL_IOStream
+  // opened on one thread is later read from another -- hardware-confirmed via
+  // a crash inside sdlStreamReadAt on this worker's first read of a disc
+  // opened by the caller thread. Fix: open the disc (and therefore do every
+  // read, since they all land on this same worker thread) from here instead.
+  // Caller must have already called start().
+  void runSync(std::function<void()> fn) {
+    auto donePromise = std::make_shared<std::promise<void>>();
+    std::future<void> doneFuture = donePromise->get_future();
+    {
+      std::lock_guard lk{m_mutex};
+      m_syncTask = [fn = std::move(fn), donePromise]() {
+        fn();
+        donePromise->set_value();
+      };
+    }
+    m_cv.notify_one();
+    doneFuture.wait();
+  }
