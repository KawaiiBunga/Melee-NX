+// Persist the current disc's FST and DiskID so the game can later boot from a
+// `files/` extraction with the disc image removed. Only meaningful right after
+// a real disc open (before any overlay/mod entries exist). Safe no-op in loose
+// mode. Reuses Aurora's own built FST, so the loose boot navigates identically.
+bool aurora_dvd_save_meta(const char* meta_path) {
+  constexpr u32 kMetaMagic = 0x4D4C5601u; // "MLV\1"
+  std::lock_guard lock(s_fstLock);
+  if (!s_initialized || s_looseMode || meta_path == nullptr || s_fstEntries.empty()) {
+    return false;
+  }
+  SDL_IOStream* io = nullptr;
+  {
+    SWITCH_IO_LOCK();
+    io = SDL_IOFromFile(meta_path, "wb");
+  }
+  if (io == nullptr) {
+    return false;
+  }
+  bool ok = SDL_WriteU32LE(io, kMetaMagic) && SDL_WriteU32LE(io, 1u);
+  ok = ok && SDL_WriteIO(io, &s_diskID, sizeof(s_diskID)) == sizeof(s_diskID);
+  ok = ok && SDL_WriteU32LE(io, static_cast<u32>(s_baseEntryCount)) &&
+       SDL_WriteU32LE(io, static_cast<u32>(s_fstEntries.size()));
+  for (const auto& e : s_fstEntries) {
+    ok = ok && SDL_WriteU8(io, e.isDir ? 1 : 0) && SDL_WriteS32LE(io, e.parent) &&
+         SDL_WriteU32LE(io, e.nextOrLength) && SDL_WriteS32LE(io, e.origEntryNum) &&
+         SDL_WriteU32LE(io, static_cast<u32>(e.name.size()));
+    if (ok && !e.name.empty()) {
+      ok = SDL_WriteIO(io, e.name.data(), e.name.size()) == e.name.size();
+    }
+    if (!ok) {
+      break;
+    }
+  }
+  SDL_CloseIO(io);
+  return ok;
+}
