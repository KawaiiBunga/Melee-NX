+// melee-nx launcher mods: MELEE_MODS_MANIFEST names a file of "disc path<TAB>SD path" lines
+// (launcher/source/data/mods.cpp). Every loader opens files through DVDFastOpen, including the
+// fighter preloader (lbdvd.c), so a listed file is served from the mod with the mod's own length.
+// melee-pc's file_cache.cpp applies the same list to lbFile's extracted-files path.
+const std::unordered_map<std::string, std::string>& modOverlay() {
+  static const std::unordered_map<std::string, std::string> overlay = [] {
+    std::unordered_map<std::string, std::string> map;
+    const char* manifest = std::getenv("MELEE_MODS_MANIFEST");
+    if (manifest == nullptr || manifest[0] == '\0') {
+      return map;
+    }
+    std::ifstream in(manifest);
+    std::string line;
+    while (std::getline(in, line)) {
+      if (!line.empty() && line.back() == '\r') {
+        line.pop_back();
+      }
+      const size_t tab = line.find('\t');
+      if (line.empty() || line[0] == '#' || tab == std::string::npos || tab == 0 || tab + 1 >= line.size()) {
+        continue;
+      }
+      std::string key = line.substr(0, tab);
+      for (char& c : key) {
+        c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+      }
+      map.emplace(std::move(key), line.substr(tab + 1));
+    }
+    std::printf("[dvd] mod overlay: %zu files from %s\n", map.size(), manifest);
+    return map;
+  }();
+  return overlay;
+}
+
+std::string modPathFor(FstIndex fstIndex) {
+  const auto& overlay = modOverlay();
+  if (overlay.empty()) {
+    return {};
+  }
+  std::string key = build_path(fstIndex);
+  while (!key.empty() && key[0] == '/') {
+    key.erase(key.begin());
+  }
+  for (char& c : key) {
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  }
+  const auto it = overlay.find(key);
+  return it == overlay.end() ? std::string() : it->second;
+}
