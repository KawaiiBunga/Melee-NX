+// Reads a single extracted file straight off the SD card, used when booting
+// from a completed `files/` extraction with the source disc image removed.
+// Each opened DVD file gets its own stream/position, so the worker can read
+// them independently just as it does per-file nod handles.
+class CommandDataLoose final : public CommandDataBase {
+public:
+  SDL_IOStream* io;
+  explicit CommandDataLoose(SDL_IOStream* stream) : io(stream) { }
+  ~CommandDataLoose() override {
+    if (io != nullptr) {
+      SDL_CloseIO(io);
+    }
+  }
+
+  int64_t read(uint8_t* buf, size_t len) override {
+    if (io == nullptr) {
+      return -1;
+    }
+    size_t total = 0;
+    while (total < len) {
+      const size_t n = SDL_ReadIO(io, buf + total, len - total);
+      if (n == 0) {
+        if (SDL_GetIOStatus(io) != SDL_IO_STATUS_EOF) {
+          return -1;
+        }
+        // On-disc file data is padded to 32 bytes with zeros, and DVD callers
+        // routinely request that aligned length. Extracted loose files hold
+        // only the exact bytes, so zero-fill the tail to match disc reads.
+        std::memset(buf + total, 0, len - total);
+        total = len;
+        break;
+      }
+      total += n;
+    }
+    return static_cast<int64_t>(total);
+  }
+
+  int64_t seek(int64_t offset, int32_t whence) override {
+    if (io == nullptr) {
+      return -1;
+    }
+    const SDL_IOWhence w =
+        whence == 1 ? SDL_IO_SEEK_CUR : whence == 2 ? SDL_IO_SEEK_END : SDL_IO_SEEK_SET;
+    return SDL_SeekIO(io, offset, w);
+  }
+};
