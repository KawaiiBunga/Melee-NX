+// Persist the current disc's FST and DiskID so the game can later boot from a
+// `files/` extraction with the disc image removed. Only meaningful right after
+// a real disc open (before any overlay/mod entries exist). Safe no-op in loose
+// mode. Reuses Aurora's own built FST, so the loose boot navigates identically.
+bool aurora_dvd_save_meta(const char* meta_path) {
+  constexpr u32 kMetaMagic = 0x4D4C5601u; // "MLV\1"
+  std::lock_guard lock(s_fstLock);
+  if (!s_initialized || s_looseMode || meta_path == nullptr || s_fstEntries.empty()) {
+    return false;
+  }
+  SDL_IOStream* io = nullptr;
+  {
+    SWITCH_IO_LOCK();
+    io = SDL_IOFromFile(meta_path, "wb");
+  }
+  if (io == nullptr) {
+    return false;
+  }
+  bool ok = SDL_WriteU32LE(io, kMetaMagic) && SDL_WriteU32LE(io, 1u);
+  ok = ok && SDL_WriteIO(io, &s_diskID, sizeof(s_diskID)) == sizeof(s_diskID);
+  ok = ok && SDL_WriteU32LE(io, static_cast<u32>(s_baseEntryCount)) &&
+       SDL_WriteU32LE(io, static_cast<u32>(s_fstEntries.size()));
+  for (const auto& e : s_fstEntries) {
+    ok = ok && SDL_WriteU8(io, e.isDir ? 1 : 0) && SDL_WriteS32LE(io, e.parent) &&
+         SDL_WriteU32LE(io, e.nextOrLength) && SDL_WriteS32LE(io, e.origEntryNum) &&
+         SDL_WriteU32LE(io, static_cast<u32>(e.name.size()));
+    if (ok && !e.name.empty()) {
+      ok = SDL_WriteIO(io, e.name.data(), e.name.size()) == e.name.size();
+    }
+    if (!ok) {
+      break;
+    }
+  }
+  SDL_CloseIO(io);
+  return ok;
+}
+
+// Boot the DVD layer from an extracted `files/` directory plus the metadata
+// aurora_dvd_save_meta wrote, with no disc image present. Additive and
+// fail-safe: on any error it leaves the layer closed and returns false, so the
+// caller can fall back to requiring the disc image.
+bool aurora_dvd_open_files(const char* files_dir, const char* meta_path) {
+  constexpr u32 kMetaMagic = 0x4D4C5601u;
+  if (files_dir == nullptr || meta_path == nullptr) {
+    return false;
+  }
+  s_worker.stop();
+  clearState();
+
+  SDL_IOStream* io = nullptr;
+  {
+    SWITCH_IO_LOCK();
+    io = SDL_IOFromFile(meta_path, "rb");
+  }
+  if (io == nullptr) {
+    return false;
+  }
+
+  u32 magic = 0, version = 0, baseCount = 0, count = 0;
+  bool ok = SDL_ReadU32LE(io, &magic) && SDL_ReadU32LE(io, &version) && magic == kMetaMagic &&
+            version == 1u && SDL_ReadIO(io, &s_diskID, sizeof(s_diskID)) == sizeof(s_diskID) &&
+            SDL_ReadU32LE(io, &baseCount) && SDL_ReadU32LE(io, &count) && count > 0 && count <= 200000u;
+
+  if (ok) {
+    std::lock_guard lock(s_fstLock);
+    s_fstEntries.clear();
+    s_fstEntries.reserve(count);
+    s32 maxEntryNum = -1;
+    for (u32 i = 0; i < count && ok; ++i) {
+      u8 isDir = 0;
+      s32 parent = 0, origEntryNum = 0;
+      u32 nextOrLength = 0, nameLen = 0;
+      ok = SDL_ReadU8(io, &isDir) && SDL_ReadS32LE(io, &parent) && SDL_ReadU32LE(io, &nextOrLength) &&
+           SDL_ReadS32LE(io, &origEntryNum) && SDL_ReadU32LE(io, &nameLen) && nameLen <= 4096u;
+      if (!ok) {
+        break;
+      }
+      std::string name(nameLen, '\0');
+      if (nameLen > 0 && SDL_ReadIO(io, name.data(), nameLen) != nameLen) {
+        ok = false;
+        break;
+      }
+      FSTEntry entry;
+      entry.name = std::move(name);
+      entry.isDir = isDir != 0;
+      entry.parent = parent;
+      entry.nextOrLength = nextOrLength;
+      entry.overlayData = nullptr;
+      entry.isOverlay = false;
+      entry.origEntryNum = origEntryNum;
+      if (origEntryNum > maxEntryNum) {
+        maxEntryNum = origEntryNum;
+      }
+      s_fstEntries.push_back(std::move(entry));
+    }
+    if (ok && maxEntryNum >= 0) {
+      s_entryNumToFstIndex.assign(static_cast<size_t>(maxEntryNum) + 1, k_invalidFstEntry);
+      for (u32 i = 0; i < s_fstEntries.size(); ++i) {
+        const s32 en = s_fstEntries[i].origEntryNum;
+        if (en >= 0 && static_cast<size_t>(en) < s_entryNumToFstIndex.size()) {
+          s_entryNumToFstIndex[en] = static_cast<FstIndex>(i);
+        }
+      }
+      s_baseEntryCount = static_cast<s32>(baseCount);
+    } else {
+      ok = false;
+    }
+  }
+  SDL_CloseIO(io);
+
+  if (!ok) {
+    clearState();
+    return false;
+  }
+
+  s_looseMode = true;
+  s_looseFilesDir = files_dir;
+  s_currentDir = 0;
+  s_currentPath = "/";
+  s_initialized = true;
+  s_worker.start();
+  return true;
+}
