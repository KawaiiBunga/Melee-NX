# ── User-supplied game disc (NEVER commit) ────────────────────────────────────
/iso/

# ── Build trees and outputs ───────────────────────────────────────────────────
/build/
/dist/

# ── Vendored upstream / reference checkouts ──────────────────────────────────
# Large third-party trees (Dawn, SDL3, Aurora, melee-pc). Reconstruct locally.
/ref/

# ── Hardware run artifacts ────────────────────────────────────────────────────
/newest_build_artifacts/

# ── Game data / Nintendo-derived content (defense in depth) ──────────────────
*.iso
*.gcm
*.ciso
*.rvz
*.dol
*.szs
*.arc
*.thp
*.gci

# ── Built homebrew binaries ───────────────────────────────────────────────────
*.nro
*.nso
*.elf
*.nacp
*.map
*.pfs0
*.npdm

# ── Caches / logs / scratch ───────────────────────────────────────────────────
*.log
*.db
*.zip
*.7z
scratch_*
/scratchpad/
/Logs/
/scratch/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# ── Internal / AI notes (never publish) ──────────────────────────────────────
# docs/ holds design notes and handoffs kept local; the public docs are the
# root README.md, BUILDING.md, docs/DEPS.md, and switch/patches/README.md, which
# stay tracked despite the /docs/ rule because git honors explicit tracking.
/memory/
/docs/
.claude/
/AGENTS.md
/CLAUDE.md
/PROGRESS.md
/PERFORMANCE.md
